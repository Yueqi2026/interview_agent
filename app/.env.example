# Browser-side configuration. Never put API secrets here.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000

# Supabase browser authentication. Both values are publishable identifiers,
# but still keep environment-specific values outside source control.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Cloudflare Worker Build variables when QuickRouter is enabled:
# VITE_API_MODE=remote
# VITE_API_BASE_URL=/api
# Worker-only values:
# AI_BASE_URL=https://api.quickrouter.ai/v1
# AI_MODEL=gpt-5.6-sol
# QUICKROUTER_API_KEY (Cloudflare Secret)
# ENVIRONMENT=production
