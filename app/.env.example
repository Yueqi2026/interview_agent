# Browser-side configuration. Never put API secrets here.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000

# Cloudflare Worker Build variables when QuickRouter is enabled:
# VITE_API_MODE=remote
# VITE_API_BASE_URL=/api
# Worker-only values:
# AI_BASE_URL=https://api.quickrouter.ai/v1
# AI_MODEL=gpt-5.6-sol
# QUICKROUTER_API_KEY (Cloudflare Secret)
# ENVIRONMENT=production
